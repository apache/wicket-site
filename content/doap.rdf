	<Project rdf:about="https://wicket.apache.org/">
		<created>2004-04-01</created>
		<license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0.txt"/>
		<name>Apache Wicket</name>
		<homepage rdf:resource="https://wicket.apache.org"/>
		<asfext:pmc rdf:resource="https://wicket.apache.org/"/>
		<shortdesc>Apache Wicket is an open source, component-oriented Java web framework.</shortdesc>
		<description>Apache Wicket is a component-oriented Java web framework, open source since 2004 and a project of the Apache Software Foundation since 2007. Every component keeps its behaviour and state in Java and its markup in plain HTML, so there is no JavaScript build chain to maintain.</description>
		<bug-database rdf:resource="https://github.com/apache/wicket/issues"/>
		<mailing-list rdf:resource="https://wicket.apache.org/community/#lists"/>
		<download-page rdf:resource="https://wicket.apache.org/versions/"/>
		<programming-language>Java</programming-language>
		<category rdf:resource="https://projects.apache.org/category/web-framework"/>
